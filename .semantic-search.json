{
  "extensions": [
    ".php",
    ".js",
    ".jsx",
    ".ts",
    ".tsx",
    ".vue",
    ".py",
    ".rb",
    ".go",
    ".rs",
    ".java",
    ".cs",
    ".swift",
    ".kt",
    ".css",
    ".scss",
    ".less",
    ".blade.php",
    ".mjs",
    ".cjs"
  ],
  "skipDirs": [
    "node_modules",
    "vendor",
    ".git",
    "dist",
    "build",
    ".cache",
    ".turbo",
    ".next",
    "public",
    "storage",
    "target",
    "__pycache__",
    ".venv",
    "venv",
    "env",
    "bower_components"
  ],
  "model": "Xenova/bge-small-en-v1.5",
  "chunkThreshold": 300,
  "defaultLimit": 10,
  "maxChunksPerFile": 4
}
